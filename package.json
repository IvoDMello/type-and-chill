{
  "name": "type-and-chill",
  "version": "1.0.0",
  "private": true,
  "description": "Jogo relaxante de digitação e vocabulário em inglês. O jogo em si roda sem build — isto aqui é só o ferramental de teste.",
  "scripts": {
    "serve": "node tools/serve.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"js/words.js\" --test-coverage-exclude=\"js/examples.js\" --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-timeout=240000 \"tests/e2e/**/*.test.js\"",
    "test:all": "npm run coverage && npm run test:e2e"
  },
  "devDependencies": {
    "puppeteer-core": "^24.10.0"
  }
}
